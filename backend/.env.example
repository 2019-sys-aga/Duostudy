# OpenAI
OPENAI_API_KEY=sk-...

# Model (optional)
MODEL=gpt-4o-mini

# Server
PORT=8080

# Supabase (server-side service role key — keep secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_here

# Supabase anon key (optional here for server-to-client support)
SUPABASE_ANON_KEY=anon_public_key_here